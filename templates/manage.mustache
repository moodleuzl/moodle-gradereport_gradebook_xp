<h1>List of competencies</h1>
{{#competencies}}
    <div class="card mt-2 mb-2">
        <div class="card-body">
            <h4 style="font-weight: bold;">{{name}}</h4>
            <table>
                <tr>
                    <td><strong>ID:</strong></td>
                    <td>{{id}}</td>
                    <td style="padding-left: 20px;"><strong>Parent ID:</strong></td>
                    <td>{{parentid}}</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td><strong>Name:</strong></td>
                    <td>{{name}}</td>
                    <td style="padding-left: 20px;"><strong>Parent Name:</strong></td>
                    <td>{{parentname}}</td>
                    <td style="padding-left: 20px;"><strong>Description:</strong></td>
                    <td>{{description}}</td>
                </tr>
            </table>


            <input type="button" class="btn btn-primary" value="Edit competency" onclick="location.href='{{editurl}}?courseid={{courseid}}&id={{id}}&action=edit'">
            <input type="button" class="btn btn-danger local_message_delete_button" name="delete-competency" value="Delete competency" onclick="if(confirm('Are you sure you want to delete this competency?')){location.href='{{editurl}}?courseid={{courseid}}&id={{id}}&action=delete'}">
        </div>
    </div>
{{/competencies}}

<hr>
<input type="button" class="btn btn-primary" value="Create message" onclick="location.href='{{editurl}}?courseid={{courseid}}'">
